/* 结果页样式 */

/* 优先级横幅 */
.priority-banner {
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.priority-label {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.priority-hint {
  font-size: 28rpx;
  opacity: 0.85;
  line-height: 1.5;
}

/* 摘要 */
.summary-grid {
  display: flex;
  gap: 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.confidence-bar {
  width: 100%;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF9B9B);
  border-radius: 6rpx;
  transition: width 0.5s;
}

.confidence-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.reasoning-box {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F0F0F0;
}

.reasoning-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.reasoning-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
}

/* 发给爸妈的话 */
.rebuttal-card {
  border: 4rpx solid #FF6B6B;
}

.rebuttal-text {
  font-size: 34rpx;
  color: #1A1A1A;
  line-height: 1.8;
  padding: 16rpx 0;
}

.rebuttal-sources {
  font-size: 26rpx;
  color: #888;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #EEE;
}

.rebuttal-actions {
  margin-top: 24rpx;
  text-align: center;
}

/* 行为话术 */
.behavior-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.behavior-item:last-child {
  border-bottom: none;
}

.behavior-type {
  display: inline-block;
  background: #FFF0F0;
  color: #E53E3E;
  font-size: 28rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.behavior-evidence {
  font-size: 30rpx;
  color: #333;
  margin: 8rpx 0;
  line-height: 1.6;
}

.behavior-confidence {
  font-size: 24rpx;
  color: #AAA;
}

/* 证据链 */
.evidence-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.evidence-item:last-child {
  border-bottom: none;
}

.evidence-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.evidence-source {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.evidence-tier {
  font-size: 24rpx;
  color: #999;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.evidence-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.evidence-snippet {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  background: #F9F9F9;
  padding: 16rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #FF6B6B;
}

.evidence-url {
  font-size: 28rpx;
  color: #FF6B6B;
  margin-top: 12rpx;
}

/* 运行说明 */
.note-item {
  font-size: 26rpx;
  color: #888;
  padding: 12rpx 0;
  line-height: 1.6;
}

/* 完整报告 */
.toggle-arrow {
  margin-left: auto;
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.full-report {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
  background: #F9F9F9;
  padding: 24rpx;
  border-radius: 16rpx;
  max-height: 1000rpx;
  overflow-y: auto;
}

/* 底部 */
.bottom-actions {
  margin: 32rpx 0;
}

.footer-info {
  text-align: center;
  font-size: 24rpx;
  color: #BBB;
  padding: 16rpx 0 48rpx;
  line-height: 1.6;
}

.error-msg {
  text-align: center;
  color: #999;
  font-size: 32rpx;
  padding: 80rpx 0;
}
